#pragma once

#include <string>
#include <memory>
#include <string_view>
#include <unordered_map>

namespace game_config
{
    inline constexpr std::string_view name = "@GAME_NAME@";
    inline constexpr std::string_view version = "@GAME_VERSION@";
    inline constexpr std::string_view category = "@GAME_CATEGORY@";
    inline constexpr std::string_view start_scene = "@GAME_START_SCENE@";
    inline constexpr std::string_view asset_provider = "@GAME_ASSET_PROVIDER_CLASS@";

    inline constexpr int window_width = @GAME_WINDOW_WIDTH@;
    inline constexpr int window_height = @GAME_WINDOW_HEIGHT@;

    template <typename T>
    auto get_asset_provider(const std::unordered_map<std::string, std::shared_ptr<T>>& asset_providers) -> std::shared_ptr<T>
    {
        auto it = asset_providers.find(std::string(asset_provider));
        if (it != asset_providers.end()) {
            return it->second;
        }
        return nullptr;
    }
}